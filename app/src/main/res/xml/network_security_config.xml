<?xml version="1.0" encoding="utf-8"?>
<!--
    Permite trafico HTTP (sin TLS) unicamente hacia el servidor XAMPP local. Es necesario porque
    RetrofitClient.BASE_URL usa "http://" (XAMPP no tiene certificado HTTPS) y, a partir de
    Android 9 (API 28), el cleartext (HTTP sin cifrar) esta bloqueado por defecto.

    - 10.0.2.2: direccion especial que usa el EMULADOR de Android Studio para llegar al
      "localhost" de la PC que lo hospeda.
    - localhost / 127.0.0.1: por si se prueba desde dentro del propio dispositivo.

    IMPORTANTE: este archivo NO admite rangos ni comodines para IPs (192.168.x.x no es valido),
    solo direcciones exactas. Cuando pruebes con un CELULAR FISICO en la misma WiFi que tu PC,
    agrega la IP local EXACTA de tu PC (la que te da "ipconfig") como una linea <domain> mas,
    por ejemplo: <domain includeSubdomains="false">192.168.1.35</domain>
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>

        <!-- Descomenta y ajusta esta linea cuando pruebes con celular fisico:
        <domain includeSubdomains="false">192.168.1.35</domain>
        -->
    </domain-config>
</network-security-config>
